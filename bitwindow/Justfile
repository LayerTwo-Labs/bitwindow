fix:
    dart fix --apply

format:
    find . -name "*.dart" -not -path "./lib/gen/*" | xargs dart format

lint: format fix

gen-server:
    cd server && buf generate --template buf.go.gen.yaml .

gen: gen-server gen-bitwindow-client

gen-version:
    cd ../ && bash scripts/generate-version.sh bitwindow

gen-bitwindow-client:
    cd ../sail_ui && just gen

clean:
    find assets/bin -type f ! -name .gitkeep -delete

download:
    bash scripts/download-binaries.sh
    flutter pub get

run: download
    #!/usr/bin/env bash
    extra="${FLUTTER_RUN_ARGS:-}"
    case "$(uname -s)" in
        Darwin*)  flutter run $extra -d macos;;    # macOS
        Linux*)   flutter run $extra -d linux;;    # Linux
        MINGW*|MSYS*|CYGWIN*)  flutter run $extra -d windows;; # Windows
        *)        echo "Unknown operating system" && exit 1 ;;
    esac

build: 
    #!/usr/bin/env bash
    case "$(uname -s)" in
        Darwin*)  flutter build  macos;;    # macOS
        Linux*)   flutter build  linux;;    # Linux
        MINGW*|MSYS*|CYGWIN*)  flutter build windows;; # Windows
        *)        echo "Unknown operating system" && exit 1 ;;
    esac
# Builds bitwindowd and drivechaind into one static library per iOS SDK.
# BITWINDOW_DEFAULT_NETWORK sets the network of a new install.
ios-backend:
    #!/usr/bin/env bash
    set -euo pipefail
    network_ldflag() { [[ -z "${BITWINDOW_DEFAULT_NETWORK:-}" ]] || echo "-X github.com/LayerTwo-Labs/sidesail/sidechain-orchestrator/config.DefaultNetwork=$BITWINDOW_DEFAULT_NETWORK"; }
    for pair in iphonesimulator:arm64-apple-ios15.0-simulator iphoneos:arm64-apple-ios15.0; do
        sdk="${pair%%:*}"
        out="$PWD/ios/Backend/$sdk"
        mkdir -p "$out"
        export CGO_ENABLED=1 GOOS=ios GOARCH=arm64
        export CC="$(xcrun --sdk "$sdk" -f clang) -isysroot $(xcrun --sdk "$sdk" --show-sdk-path) -target ${pair#*:}"
        (cd server && go build -trimpath -buildmode=c-archive -ldflags="-s -w $(network_ldflag)" -o "$out/libbitwindow_backend.a" ./mobile)
    done

# Builds the Thunder node into one static library per iOS SDK, next to the backend.
ios-thunder:
    #!/usr/bin/env bash
    set -euo pipefail
    export IPHONEOS_DEPLOYMENT_TARGET=15.0
    target_dir="${CARGO_TARGET_DIR:-$PWD/../thunder_bridge/rust/target}"
    for pair in iphonesimulator:aarch64-apple-ios-sim iphoneos:aarch64-apple-ios; do
        sdk="${pair%%:*}"
        triple="${pair#*:}"
        (cd ../thunder_bridge/rust && cargo build --release --target "$triple")
        mkdir -p "ios/Backend/$sdk"
        cp "$target_dir/$triple/release/libthunder_bridge.a" "ios/Backend/$sdk/"
    done

ios: ios-backend ios-thunder
    flutter build ios --simulator

# Builds bitwindowd and drivechaind into one library in the APK's arm64 jniLibs folder.
# BITWINDOW_DEFAULT_NETWORK sets the network of a new install.
android-backend:
    #!/usr/bin/env bash
    set -euo pipefail
    network_ldflag() { [[ -z "${BITWINDOW_DEFAULT_NETWORK:-}" ]] || echo "-X github.com/LayerTwo-Labs/sidesail/sidechain-orchestrator/config.DefaultNetwork=$BITWINDOW_DEFAULT_NETWORK"; }
    sdk="${ANDROID_HOME:-$(flutter config --list | sed -n 's/^ *android-sdk: //p')}"
    ndk="$(ls -d "$sdk"/ndk/* | sort -V | tail -1)"
    cc="$(ls "$ndk"/toolchains/llvm/prebuilt/*/bin/aarch64-linux-android29-clang)"
    out="$PWD/android/app/src/main/jniLibs/arm64-v8a"
    mkdir -p "$out"
    export CGO_ENABLED=1 GOOS=android GOARCH=arm64 CC="$cc"
    (cd server && go build -trimpath -buildmode=c-shared -ldflags="-s -w $(network_ldflag) -extldflags=-Wl,-z,max-page-size=16384" -o "$out/libbitwindow_backend.so" ./mobile)
    rm "$out/libbitwindow_backend.h"

# Builds the Thunder node into the APK's arm64 jniLibs folder.
android-thunder:
    #!/usr/bin/env bash
    set -euo pipefail
    sdk="${ANDROID_HOME:-$(flutter config --list | sed -n 's/^ *android-sdk: //p')}"
    ndk="$(ls -d "$sdk"/ndk/* | sort -V | tail -1)"
    bin="$(ls -d "$ndk"/toolchains/llvm/prebuilt/*/bin)"
    # Only the target variables: a plain CC would build the host build scripts with the Android clang.
    export CC_aarch64_linux_android="$bin/aarch64-linux-android29-clang"
    export AR_aarch64_linux_android="$bin/llvm-ar"
    export CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER="$bin/aarch64-linux-android29-clang"
    export CARGO_TARGET_AARCH64_LINUX_ANDROID_RUSTFLAGS="-C link-arg=-Wl,-z,max-page-size=16384"
    target_dir="${CARGO_TARGET_DIR:-$PWD/../thunder_bridge/rust/target}"
    (cd ../thunder_bridge/rust && cargo build --release --target aarch64-linux-android)
    out="$PWD/android/app/src/main/jniLibs/arm64-v8a"
    mkdir -p "$out"
    cp "$target_dir/aarch64-linux-android/release/libthunder_bridge.so" "$out/"

android: android-backend android-thunder
    flutter build apk --target-platform android-arm64
